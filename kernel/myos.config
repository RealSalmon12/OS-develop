# SockOS 커널 설정 조각. defconfig 위에 덮어씁니다.
CONFIG_DEFAULT_HOSTNAME="sockos"
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
# QEMU 가상 장치
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_E1000=y
# 그래픽 (3단계 준비): QEMU 표준 VGA + 프레임버퍼 콘솔
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
# 소리 (유튜브용, 4단계 준비)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_GENERIC=y
# 컴파일러 경고 때문에 빌드가 멈추지 않게 합니다
# CONFIG_WERROR is not set
