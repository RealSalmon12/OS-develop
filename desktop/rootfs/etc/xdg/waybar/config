{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "margin": "0 8 6 8",
  "spacing": 6,
  "modules-left": ["custom/start", "custom/web", "custom/youtube", "custom/files", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["custom/shot", "tray", "network", "pulseaudio", "clock", "custom/power"],
  "custom/start": {
    "format": "🧦 SockOS",
    "tooltip-format": "앱 메뉴",
    "on-click": "fuzzel"
  },
  "custom/web": {
    "format": "🌐 인터넷",
    "tooltip": false,
    "on-click": "sockos-browser"
  },
  "custom/youtube": {
    "format": "▶ 유튜브",
    "tooltip": false,
    "on-click": "sockos-browser https://www.youtube.com"
  },
  "custom/files": {
    "format": "📁 파일",
    "tooltip": false,
    "on-click": "pcmanfm-qt"
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 20,
    "icon-theme": "Papirus-Dark",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "network": {
    "format-ethernet": "🌐 연결됨",
    "format-wifi": "📶 {essid}",
    "format-disconnected": "⚠ 인터넷 없음",
    "tooltip-format": "{ifname} {ipaddr}"
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 음소거",
    "on-click": "pavucontrol-qt",
    "scroll-step": 5
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y년 %m월 %d일 %A}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#b79cff'><b><u>{}</u></b></span>" }
    },
    "locale": "ko_KR.UTF-8"
  },
  "tray": { "icon-size": 18, "spacing": 8 },
  "custom/shot": {
    "format": "📷 캡처",
    "tooltip": false,
    "on-click": "sockos-screenshot area",
    "on-click-right": "sockos-screenshot"
  },
  "custom/power": {
    "format": "전원",
    "tooltip-format": "전원",
    "on-click": "sockos-power"
  }
}
