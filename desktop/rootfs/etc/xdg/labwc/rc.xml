<?xml version="1.0"?>
<!-- SockOS 창 관리 설정 (labwc) -->
<labwc_config>
  <core><gap>6</gap></core>
  <theme>
    <name>SockOS</name>
    <cornerRadius>10</cornerRadius>
    <font place="ActiveWindow"><name>Noto Sans CJK KR</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Noto Sans CJK KR</name><size>10</size></font>
    <font place="MenuItem"><name>Noto Sans CJK KR</name><size>10</size></font>
  </theme>
  <placement><policy>center</policy></placement>
  <keyboard>
    <default />
    <!-- Windows 키: 앱 메뉴 -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-b"><action name="Execute" command="falkon" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png'" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
</labwc_config>
